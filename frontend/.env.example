# ====================================================================
# Clio Environment Configuration Template
# Copy this file to frontend/.env.local and fill in your credentials
# ====================================================================

# 1. Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# 2. Cryptographic Session & Faculty Registration Security (Required)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
TEACHER_INVITE_CODE=

# 3. Pure Rust Compute Engine Configuration (Optional — falls back to TypeScript automatically)
CLIO_ENGINE_URL=http://127.0.0.1:8088
CLIO_ENGINE_KEY=
