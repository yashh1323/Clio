# ====================================================================
# Clio Environment Configuration Template
# Copy this file to frontend/.env.local and fill in your credentials
# ====================================================================

# 1. Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# 2. Cryptographic Session & Faculty Registration Security (Required in Production)
AUTH_SECRET=replace_with_64_char_cryptographic_random_hex_secret
TEACHER_INVITE_CODE=replace_with_institutional_faculty_invite_code

# 3. Pure Rust Compute Engine Configuration (Optional — falls back to TypeScript automatically)
CLIO_ENGINE_URL=http://127.0.0.1:8088
CLIO_ENGINE_KEY=replace_with_shared_hmac_engine_key
